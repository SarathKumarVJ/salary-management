{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bin/rails db:*)",
      "Bash(bin/rails routes:*)",
      "Bash(bin/rails generate:*)",
      "Bash(bin/rails runner:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git -C * commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout -- :*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./backend/config/master.key)"
    ]
  }
}
