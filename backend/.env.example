# Copy to .env and adjust for your local MySQL
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=127.0.0.1

# Comma-separated origins allowed to call /api/* (deployed frontend URL in production)
CORS_ORIGINS=http://localhost:5173

# HR Manager created by `bin/rails db:seed` (required in production; dev defaults: hr@acme.test / local-dev-password)
HR_MANAGER_EMAIL=hr@acme.test
HR_MANAGER_PASSWORD=local-dev-password
